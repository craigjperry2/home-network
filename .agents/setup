#!/usr/bin/env bash
# Amp orb setup: installs single-user Nix, pre-fetches the flake inputs and dev
# shells used by .pre-commit-config.yaml, and makes the nix/ dev shell the
# environment of login shells started at the repo root. Idempotent; reruns on
# a stale snapshot only redo what changed.
set -euo pipefail

NIX_VERSION=2.35.2
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nix_profile="$HOME/.nix-profile"
cd "$repo_root"

step() {
  local label=$1
  shift
  local start=$SECONDS
  printf '==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - start))"
}

install_nix() {
  if [ -x "$nix_profile/bin/nix" ]; then
    "$nix_profile/bin/nix" --version
    return
  fi
  # Single-user install: no daemon to restart after the orb resumes.
  curl -fsSL "https://releases.nixos.org/nix/nix-$NIX_VERSION/install" |
    NIX_INSTALLER_NO_MODIFY_PROFILE=1 sh -s -- --no-daemon --no-channel-add
}

configure_nix() {
  mkdir -p "$HOME/.config/nix"
  local conf="$HOME/.config/nix/nix.conf"
  local line="experimental-features = nix-command flakes"
  grep -Fqx "$line" "$conf" 2>/dev/null || printf '%s\n' "$line" >>"$conf"
}

configure_profile() {
  # Rewritten on every run so changes here reach stale snapshots.
  local hook="$HOME/.config/home-network/profile.sh"
  mkdir -p "$(dirname "$hook")"
  # stderr is dropped because the dev shell's `prek install` refuses to run
  # under the orb's global core.hooksPath and would print on every login.
  cat >"$hook" <<EOF
# Generated by $repo_root/.agents/setup
if [ -e "$nix_profile/etc/profile.d/nix.sh" ]; then
  . "$nix_profile/etc/profile.d/nix.sh"
  if [[ -z "\${IN_NIX_SHELL:-}" && "\$PWD" == "$repo_root" ]]; then
    eval "\$("$nix_profile/bin/nix" print-dev-env "$repo_root/nix" 2>/dev/null)" 2>/dev/null
    # Keep Amp's wrappers (its gh supplies GitHub auth) ahead of the dev shell's.
    if [ -d "$HOME/.amp/bin" ]; then PATH="$HOME/.amp/bin:\$PATH"; fi
  fi
fi
EOF
  local line="[ -f \"$hook\" ] && . \"$hook\""
  if ! grep -Fqx "$line" "$HOME/.bash_profile" 2>/dev/null; then
    printf '\n# home-network: Nix and nix/ dev shell (from .agents/setup)\n%s\n' "$line" >>"$HOME/.bash_profile"
  fi
}

step "Install Nix $NIX_VERSION" install_nix
step "Configure Nix" configure_nix
# The installer cannot update this running script's environment.
# shellcheck disable=SC1091
. "$nix_profile/etc/profile.d/nix.sh"

step "Fetch nix/ flake inputs" nix flake archive ./nix
step "Fetch scripts/ flake inputs" nix flake archive ./scripts
step "Build nix/ dev shell" nix develop ./nix -c true
step "Build scripts/ dev shell" nix develop ./scripts -c true
# shellcheck disable=SC2016 # expanded by the inner bash
step "Warm uv cache for scripts/" nix develop ./scripts -c bash -c \
  'for f in scripts/*.py; do uv run --with-requirements "$f" python -c pass; done'
# `nix flake check` is not warmed here: it re-evaluates every host (~50s) on
# each rerun while saving only ~25s on the first check in a fresh orb.
step "Configure login shell" configure_profile
